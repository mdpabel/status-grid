---
import Base from './Base.astro';
const { frontmatter } = Astro.props;
const { title, description, category, date, readingTime } = frontmatter;
---
<Base title={title} description={description} type="article" published={date}>
  <section class="page-hero article-hero"><div class="container"><a class="back" href="/blog/">← All guides</a><div class="eyebrow">{category} · {readingTime}</div><h1>{title}</h1><p>{description}</p><div class="article-meta">Updated {new Date(date).toLocaleDateString('en-US',{year:'numeric',month:'long',day:'numeric'})} · StatusGrid guide</div></div></section>
  <div class="container article-wrap"><article class="prose"><slot /></article><aside class="article-side"><div class="side-card"><span class="eyebrow">Try it yourself</span><h2>See what your URLs actually return.</h2><p>Check status codes, redirect hops, and page signals in one report.</p><a href="/#checker">Open the checker →</a></div><div class="side-links"><strong>Keep reading</strong><a href="/blog/http-status-codes-seo/">HTTP status codes and SEO</a><a href="/blog/301-vs-302-redirects/">301 vs 302 redirects</a><a href="/blog/404-vs-410-soft-404/">404, 410, and soft 404</a><a href="/blog/503-vs-429/">503 vs 429</a><a href="/blog/ai-search-crawlability/">AI search and crawlability</a></div></aside></div>
  <div class="container"><div class="cta-strip"><div><h2>Ready to inspect your own URLs?</h2><p>Run a batch check and export the findings.</p></div><a class="button" href="/#checker">Check URLs →</a></div></div>
</Base>
<style>.article-hero{padding-bottom:72px}.article-hero h1{font-size:clamp(40px,5.2vw,66px);max-width:820px}.article-hero p{max-width:760px}.back{display:block;width:max-content;color:#b4c5c8;font-size:13px;margin-bottom:35px}.back:hover{color:#d9f879}.article-meta{font-size:12px;color:#8da1aa;margin-top:27px}.article-wrap{display:grid;grid-template-columns:minmax(0,760px) 260px;gap:80px;padding-top:60px}.article-side{padding-top:20px}.side-card{background:#19332d;border-radius:13px;padding:25px;color:#fff}.side-card h2{font-size:24px;margin:15px 0 8px}.side-card p{color:#b2c7bd;font-size:13px}.side-card a{color:#d9f879;font-weight:700;font-size:13px}.side-links{display:flex;flex-direction:column;gap:15px;margin-top:35px;font-size:13px}.side-links strong{font:700 16px 'Space Grotesk'}.side-links a{color:#567065}.side-links a:hover{color:#21573e}.cta-strip{margin-bottom:80px}@media(max-width:900px){.article-wrap{grid-template-columns:1fr;gap:30px}.article-side{display:none}}</style>
