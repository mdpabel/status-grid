---
import Base from '../../layouts/Base.astro';
const posts = [
  {title:'HTTP status codes and SEO: what actually matters',desc:'A practical field guide to the responses search engines and visitors encounter, and the next action for each class.',tag:'Fundamentals',time:'8 min read',url:'/blog/http-status-codes-seo/'},
  {title:'301 vs 302 redirects: choosing the right move',desc:'Permanent and temporary moves are simple in theory. Use these checks to make your redirect map work in practice.',tag:'Redirects',time:'6 min read',url:'/blog/301-vs-302-redirects/'},
  {title:'404, 410, and soft 404: a cleanup playbook',desc:'Decide whether a removed page should return an error, redirect to a replacement, or stay live.',tag:'Errors',time:'7 min read',url:'/blog/404-vs-410-soft-404/'},
  {title:'503 vs 429: handling temporary outages and rate limits',desc:'How to send honest temporary signals when a server is overloaded or under maintenance.',tag:'Operations',time:'5 min read',url:'/blog/503-vs-429/'},
  {title:'AI search starts with crawlable pages',desc:'What AI search visibility guidance actually says about indexing, snippets, and technical access.',tag:'AI search',time:'6 min read',url:'/blog/ai-search-crawlability/'}
];
---
<Base title="HTTP Status & Technical SEO Guides" description="Practical guides to HTTP status codes, redirects, crawlability, and technical SEO, grounded in official documentation."><section class="page-hero"><div class="container"><span class="eyebrow">The StatusGrid field notes</span><h1>Technical SEO, without the fog.</h1><p>Clear guides to the responses behind every URL—and the decisions that follow.</p></div></section><section class="content-section"><div class="container"><div class="post-grid">{posts.map(post=><a class="post-card" href={post.url}><span>{post.tag} · {post.time}</span><h2>{post.title}</h2><p>{post.desc}</p><b>Read guide ↗</b></a>)}</div></div></section></Base>
<style>.post-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:20px}.post-card{background:white;border:1px solid #dfe8e1;border-radius:14px;padding:32px;min-height:300px;display:flex;flex-direction:column;transition:transform .2s,box-shadow .2s}.post-card:hover{transform:translateY(-3px);box-shadow:0 15px 35px #162f1b0d}.post-card span{color:#58805b;font-size:11px;letter-spacing:1px;text-transform:uppercase;font-weight:700}.post-card h2{font-size:29px;margin:26px 0 12px;max-width:480px}.post-card p{color:#697a70;font-size:15px;margin:0}.post-card b{margin-top:auto;color:#2c704f;font-size:13px;padding-top:30px}@media(max-width:700px){.post-grid{grid-template-columns:1fr}.post-card{min-height:260px}}</style>
