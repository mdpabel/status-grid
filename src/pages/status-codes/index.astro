---
import Base from '../../layouts/Base.astro';
const groups = [
  { range:'2xx', name:'Success', description:'The server received and handled the request.', codes:[['200','OK','The requested resource was delivered.'],['201','Created','The request created a resource.'],['202','Accepted','The request was accepted for processing.'],['204','No Content','The request succeeded with no response body.'],['206','Partial Content','The server delivered a requested byte range.']] },
  { range:'3xx', name:'Redirects', description:'The client needs to take another step, often following a new URL.', codes:[['301','Moved Permanently','The resource has a lasting new URL.'],['302','Found','The resource is temporarily available elsewhere.'],['304','Not Modified','The cached representation can be reused.'],['307','Temporary Redirect','A temporary move that preserves the request method.'],['308','Permanent Redirect','A permanent move that preserves the request method.']] },
  { range:'4xx', name:'Client errors', description:'The request could not be fulfilled as sent.', codes:[['400','Bad Request','The server cannot process the request syntax.'],['401','Unauthorized','Authentication is required.'],['403','Forbidden','Access is refused.'],['404','Not Found','No resource was found at this URL.'],['410','Gone','The resource is unavailable and expected to remain so.'],['429','Too Many Requests','The requester has exceeded a rate limit.']] },
  { range:'5xx', name:'Server errors', description:'The server could not complete a valid request.', codes:[['500','Internal Server Error','The server encountered an unexpected failure.'],['502','Bad Gateway','An upstream server gave an invalid response.'],['503','Service Unavailable','The service is temporarily unable to handle the request.'],['504','Gateway Timeout','An upstream server did not respond in time.']] }
];
---
<Base title="HTTP Status Codes: Quick Reference" description="A clear HTTP status code reference for common 2xx, 3xx, 4xx, and 5xx responses, with practical SEO context and links to deeper guides.">
  <section class="page-hero"><div class="container"><span class="eyebrow">Keep this reference handy</span><h1>HTTP status codes, explained plainly.</h1><p>Find the meaning behind the response, then check what happened to the actual URL.</p></div></section>
  <section class="content-section"><div class="container"><div class="reference-top"><div><h2>Common response codes</h2><p>Search by number or name. These are the codes most useful in a URL audit.</p></div><label class="search-wrap"><span>⌕</span><input id="code-search" type="search" placeholder="Search 404, redirect, unavailable…" aria-label="Search status codes" /></label></div><div id="code-groups">{groups.map(group=><section class="code-group" aria-label={`${group.range} ${group.name}`}><div class="group-heading"><span class={`range range-${group.range[0]}`}>{group.range}</span><div><h3>{group.name}</h3><p>{group.description}</p></div></div><div class="code-grid">{group.codes.map(([code,name,meaning])=><article class="code-card" data-search={`${code} ${name} ${meaning}`.toLowerCase()}><strong>{code}</strong><div><h4>{name}</h4><p>{meaning}</p></div></article>)}</div></section>)}</div><p id="no-matches" hidden>No matching status codes in this quick reference. See the full <a href="https://developer.mozilla.org/en-US/docs/Web/HTTP/Reference/Status">MDN HTTP status reference</a>.</p><div class="source-note">Definitions summarized from <a href="https://developer.mozilla.org/en-US/docs/Web/HTTP/Reference/Status">MDN's HTTP status reference</a>. For search behavior, see <a href="https://developers.google.com/crawling/docs/troubleshooting/http-status-codes">Google's crawler guidance</a>.</div><div class="cta-strip"><div><h2>Know the code. Check the path.</h2><p>Test multiple URLs and inspect their final response.</p></div><a class="button" href="/#checker">Open the checker →</a></div></div></section>
</Base>
<script>const search=document.querySelector<HTMLInputElement>('#code-search')!;search.addEventListener('input',()=>{const q=search.value.trim().toLowerCase();let visible=0;document.querySelectorAll<HTMLElement>('.code-group').forEach(group=>{let inGroup=0;group.querySelectorAll<HTMLElement>('.code-card').forEach(card=>{const match=(card.dataset.search||'').includes(q);card.hidden=!match;if(match){visible++;inGroup++;}});group.hidden=!inGroup;});document.querySelector<HTMLElement>('#no-matches')!.hidden=!!visible;});</script>
<style>.reference-top{display:flex;align-items:end;justify-content:space-between;gap:20px}.reference-top h2{font-size:37px}.reference-top p{color:#677a70}.search-wrap{display:flex;align-items:center;gap:9px;padding:0 14px;border:1px solid #d1ddd1;border-radius:9px;background:white;min-width:340px;height:48px;color:#588060}.search-wrap span{font-size:22px}.search-wrap input{border:0;outline:0;background:transparent;min-width:0;width:100%;font-size:13px}.code-group{margin-top:48px}.group-heading{display:flex;gap:20px;align-items:center;margin-bottom:19px}.range{width:62px;height:62px;display:grid;place-items:center;border-radius:11px;font:700 17px 'Space Grotesk';background:#e5f3df;color:#367454}.range-3{background:#fff0d9;color:#a16c22}.range-4{background:#ffebe2;color:#b15d36}.range-5{background:#fce4e0;color:#ae403c}.group-heading h3{font-size:27px}.group-heading p{margin:3px 0 0;color:#718279;font-size:14px}.code-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:11px}.code-card{background:white;border:1px solid #e0e9e0;border-radius:10px;padding:19px;display:flex;gap:20px}.code-card strong{font:700 23px 'Space Grotesk';color:#345f4b}.code-card h4{font-size:18px}.code-card p{color:#718077;margin:5px 0 0;font-size:13px}.source-note{font-size:13px;color:#718077;margin-top:45px}.source-note a,#no-matches a{color:#2b7253;text-decoration:underline}.cta-strip{margin-bottom:0}@media(max-width:700px){.reference-top{display:block}.search-wrap{min-width:0;margin-top:20px}.code-grid{grid-template-columns:1fr}}</style>
<style>.code-card[hidden]{display:none}</style>
