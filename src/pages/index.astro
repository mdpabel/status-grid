---
import Base from '../layouts/Base.astro';
---
<Base description="Free bulk HTTP status checker for up to 50 URLs. Trace redirect chains, find errors, inspect canonical and noindex signals, and export a CSV report.">
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <div class="eyebrow">The URL audit workspace</div>
        <h1>Every URL has a <em>story.</em><br />See the whole path.</h1>
        <p>Check up to 50 URLs at once. Follow every redirect, spot broken destinations, and surface the HTTP and SEO signals that need your attention.</p>
        <div class="hero-points"><span><i></i> No account needed</span><span><i></i> Full redirect paths</span><span><i></i> Exportable results</span></div>
        <a class="hero-link" href="#checker">Start checking <span aria-hidden="true">↓</span></a>
      </div>
      <div class="hero-visual" aria-hidden="true">
        <div class="visual-top"><span><i></i><i></i><i></i></span><b>LIVE URL TRACE</b><span>↗</span></div>
        <div class="trace-line"><span class="trace-dot">01</span><div><small>REQUEST</small><strong>example.com/old-page</strong></div><b class="trace-code redirect">301</b></div>
        <div class="trace-connector"></div>
        <div class="trace-line"><span class="trace-dot">02</span><div><small>REDIRECT</small><strong>example.com/new-page</strong></div><b class="trace-code success">200</b></div>
        <div class="visual-note"><span class="pulse"></span><div><strong>Destination reached</strong><small>2 hops · 184 ms · canonical found</small></div><span>✓</span></div>
      </div>
    </div>
    <div class="hero-gridlines"></div>
  </section>

  <section class="tool-section" id="checker">
    <div class="container">
      <div class="tool-intro"><div><span class="eyebrow">01 / Run a check</span><h2>Turn a URL list into a clear action list.</h2></div><p>Paste one URL per line, or import a TXT or CSV file. We'll check the live HTTP response and follow redirects to the final page.</p></div>
      <div class="tool-shell">
        <div class="tool-bar"><span><span class="tool-icon">⌁</span> Bulk status checker</span><span class="tool-cap">UP TO 50 URLS</span></div>
        <div class="tool-body">
          <div class="input-head"><label for="urls">Your URLs</label><span id="url-count">0 / 50</span></div>
          <textarea id="urls" spellcheck="false" placeholder="https://example.com/old-page&#10;https://example.com/product&#10;https://example.com/contact" aria-describedby="input-help"></textarea>
          <div class="input-footer"><span id="input-help">One URL per line. A CSV may include expected destinations in column two.</span><div><button class="text-button" id="sample-button" type="button">Use sample</button><label class="text-button upload" for="file-input">↑ Import TXT / CSV</label><input id="file-input" type="file" accept=".txt,.csv,text/plain,text/csv" hidden /></div></div>
          <div class="tool-actions"><button class="button check-button" id="check-button" type="button">Check URLs <span aria-hidden="true">→</span></button><button class="cancel-button" id="cancel-button" type="button" hidden>Stop check</button><span id="progress-text" role="status" aria-live="polite"></span></div>
          <div id="error-message" class="error-message" role="alert" hidden></div>
        </div>
      </div>
      <div class="results" id="results" hidden>
        <div class="results-top"><div><span class="eyebrow">02 / Review the signals</span><h3>Your results</h3><p id="results-summary"></p></div><button class="button secondary" id="export-button" type="button">↓ Export CSV</button></div>
        <div id="network-notice" class="network-notice" hidden><strong>The checker server cannot reach external websites.</strong> These results say nothing about whether the sites are online. Run StatusGrid on a server with outbound HTTP and HTTPS access.</div>
        <div class="filter-row" role="group" aria-label="Filter results"><button class="filter active" data-filter="all" type="button">All <span id="count-all">0</span></button><button class="filter" data-filter="issues" type="button">Needs attention <span id="count-issues">0</span></button><button class="filter" data-filter="unverified" type="button">Could not verify <span id="count-unverified">0</span></button><button class="filter" data-filter="redirects" type="button">Redirected <span id="count-redirects">0</span></button><button class="filter" data-filter="healthy" type="button">Healthy <span id="count-healthy">0</span></button></div>
        <div class="table-wrap"><table><thead><tr><th>URL / redirect path</th><th>Final status</th><th>Time</th><th>Hops</th><th>Signals</th></tr></thead><tbody id="results-body"></tbody></table></div>
        <p class="results-note">A missing response, 403, or 429 may be specific to this server-side check. Compare the URL in a browser before treating it as a site-wide outage.</p>
      </div>
    </div>
  </section>

  <section class="feature-section"><div class="container"><div class="section-heading"><span class="eyebrow">Built for the real audit</span><h2>More context. Less guessing.</h2><p>A status code is a starting point. StatusGrid adds the path and page signals you need to decide what to fix first.</p></div><div class="feature-grid">
    <article class="feature-card"><div class="feature-icon">↗</div><h3>Every redirect hop</h3><p>See each response in the chain, its destination, and the time spent getting there. Spot loops and unnecessarily long paths.</p></article>
    <article class="feature-card"><div class="feature-icon">◎</div><h3>Indexing signals</h3><p>Inspect canonical URLs and robots directives found in response headers and initial HTML. Flag noindex and mismatched canonicals.</p></article>
    <article class="feature-card"><div class="feature-icon">▦</div><h3>Actionable triage</h3><p>Separate healthy URLs, redirects, and pages needing attention. Get clear issue labels instead of a wall of status numbers.</p></article>
    <article class="feature-card"><div class="feature-icon">⇄</div><h3>Migration map checks</h3><p>Import source and expected destination columns. Flag redirects that land on the wrong URL, then export the findings.</p></article>
  </div></div></section>

  <section class="workflow-section"><div class="container workflow-grid"><div><span class="eyebrow">A faster way to verify</span><h2>From a messy list to a better next step.</h2><p>Built for migration spot checks, broken-link cleanup, content inventories, and routine technical SEO reviews.</p><a href="/how-it-works/">Learn how checks work <span aria-hidden="true">↗</span></a></div><div class="steps"><div><b>01</b><span><strong>Add URLs</strong><small>Paste or import up to 50 public URLs.</small></span></div><div><b>02</b><span><strong>Trace each response</strong><small>Follow redirects and read page signals.</small></span></div><div><b>03</b><span><strong>Prioritize and export</strong><small>Filter issues and take the report with you.</small></span></div></div></div></section>

  <section class="learn-section"><div class="container"><div class="learn-head"><div class="section-heading"><span class="eyebrow">Learn the language of the web</span><h2>Know what the response means.</h2></div><a href="/blog/">View all guides <span aria-hidden="true">↗</span></a></div><div class="learn-grid"><a class="learn-card" href="/blog/http-status-codes-seo/"><span class="learn-tag">The essentials · 8 min read</span><h3>HTTP status codes and SEO: what actually matters</h3><p>A practical map of 2xx, 3xx, 4xx, and 5xx responses and what to investigate next.</p><span class="learn-arrow">Read guide ↗</span></a><a class="learn-card" href="/blog/301-vs-302-redirects/"><span class="learn-tag">Redirects · 6 min read</span><h3>301 vs 302 redirects: choosing the right move</h3><p>Learn when a move is permanent, when it is temporary, and why the destination matters.</p><span class="learn-arrow">Read guide ↗</span></a><a class="learn-card" href="/blog/404-vs-410-soft-404/"><span class="learn-tag">Errors · 7 min read</span><h3>404, 410, and soft 404: a cleanup playbook</h3><p>Choose the right response for removed pages and avoid “success” pages that are actually errors.</p><span class="learn-arrow">Read guide ↗</span></a></div></div></section>

  <section class="faq-section"><div class="container faq-grid"><div class="section-heading"><span class="eyebrow">Quick answers</span><h2>Before you run a check.</h2><p>Know what the tool can tell you and where a deeper investigation starts.</p></div><div class="faq-list"><details><summary>Can I check multiple URLs at once?</summary><p>Yes. Paste or import up to 50 public HTTP or HTTPS URLs. The checker processes them in small batches and lets you export the report as CSV.</p></details><details><summary>Does a 200 status mean my page is indexed?</summary><p>No. A 200 means the server successfully answered the request. Indexing also depends on content, access, directives, canonicalization, and search engine decisions. Check Search Console for Google's view.</p></details><details><summary>Will this detect redirect loops and broken destinations?</summary><p>The checker follows up to six redirects, reports each hop, and flags loops, excessive chains, and final error responses.</p></details><details><summary>Why does a site show a 403 here but load in my browser?</summary><p>Some sites treat automated server requests differently from browser traffic. Verify the URL in a browser and inspect server or security logs before treating a 403 as a site-wide outage.</p></details></div></div></section>

  <section class="bottom-cta"><div class="container"><div><span class="eyebrow">Ready when you are</span><h2>Find the weak links in your URL list.</h2><p>Run a free check and get an exportable report in minutes.</p></div><a class="button" href="#checker">Check your URLs →</a></div></section>
</Base>

<script>
  type Result = { input:string; finalUrl:string|null; expectedUrl?:string; status:number|null; statusText:string; ms:number; hops:{url:string;status:number;location:string|null;ms:number}[]; contentType:string|null; canonical:string|null; robots:string|null; title:string|null; issues:string[]; error:string|null; errorType:'blocked'|'limited'|'network'|'redirect'|'input'|null };
  const textarea = document.querySelector<HTMLTextAreaElement>('#urls')!;
  const count = document.querySelector<HTMLElement>('#url-count')!;
  const button = document.querySelector<HTMLButtonElement>('#check-button')!;
  const cancel = document.querySelector<HTMLButtonElement>('#cancel-button')!;
  const progress = document.querySelector<HTMLElement>('#progress-text')!;
  const errorBox = document.querySelector<HTMLElement>('#error-message')!;
  const resultsSection = document.querySelector<HTMLElement>('#results')!;
  const resultsBody = document.querySelector<HTMLElement>('#results-body')!;
  let results: Result[] = [];
  const expected = new Map<string,string>();
  let controller: AbortController | null = null;
  let activeFilter = 'all';
  function lines() { return [...new Set(textarea.value.split(/\r?\n/).map(v => v.trim()).filter(Boolean))]; }
  function updateCount() { const n = lines().length; count.textContent = `${n} / 50`; count.classList.toggle('over-limit', n > 50); }
  function error(message: string) { errorBox.textContent = message; errorBox.hidden = !message; }
  function normalize(value: string) { return /^[a-z][a-z\d+.-]*:\/\//i.test(value) ? value : `https://${value}`; }
  function cell(row: HTMLTableRowElement, value: string, className = '') { const td = row.insertCell(); td.textContent = value; if (className) td.className = className; return td; }
  function category(result: Result) { return result.errorType && result.errorType !== 'redirect' ? 'unverified' : (result.status ?? 0) >= 400 || result.issues.length ? 'issues' : result.hops.length > 1 ? 'redirects' : 'healthy'; }
  function render() {
    resultsBody.replaceChildren();
    const counts = { all: results.length, issues: results.filter(r => category(r) === 'issues').length, unverified: results.filter(r => category(r) === 'unverified').length, redirects: results.filter(r => category(r) === 'redirects').length, healthy: results.filter(r => category(r) === 'healthy').length };
    for (const [key, value] of Object.entries(counts)) document.querySelector(`#count-${key}`)!.textContent = String(value);
    document.querySelector('#results-summary')!.textContent = `${counts.all} attempted · ${counts.issues} need attention · ${counts.unverified} could not verify · ${counts.redirects} redirected`;
    document.querySelector<HTMLElement>('#network-notice')!.hidden = !results.some(r => r.errorType === 'blocked');
    for (const result of results.filter(r => activeFilter === 'all' || category(r) === activeFilter)) {
      const row = document.createElement('tr');
      const urlCell = row.insertCell();
      const details = document.createElement('details');
      const summary = document.createElement('summary');
      const mainUrl = document.createElement('span'); mainUrl.className = 'result-url'; mainUrl.textContent = result.input;
      const subUrl = document.createElement('small'); subUrl.textContent = result.finalUrl && result.finalUrl !== result.input ? `→ ${result.finalUrl}` : result.title || 'View response details';
      summary.append(mainUrl, subUrl); details.append(summary);
      const detailBody = document.createElement('div'); detailBody.className = 'detail-body';
      if (result.error) { const p = document.createElement('p'); p.textContent = `Checker note: ${result.error}`; detailBody.append(p); }
      for (const hop of result.hops) { const p = document.createElement('p'); p.className = 'hop-line'; p.textContent = `${hop.status}  ${hop.url}${hop.location ? `  →  ${hop.location}` : ''}  ·  ${hop.ms} ms`; detailBody.append(p); }
      for (const [label, value] of [['Expected destination', result.expectedUrl], ['Canonical', result.canonical], ['Robots directives', result.robots], ['Content type', result.contentType]] as const) { if (value) { const p = document.createElement('p'); p.textContent = `${label}: ${value}`; detailBody.append(p); } }
      details.append(detailBody); urlCell.append(details);
      const statusLabel = result.errorType === 'blocked' ? 'Checker blocked' : result.errorType === 'limited' && result.status ? `${result.status} ${result.statusText} · access limited` : result.errorType && result.errorType !== 'redirect' ? 'Could not verify' : result.errorType === 'redirect' && result.status ? `${result.status} · incomplete` : result.status ? `${result.status} ${result.statusText}` : 'No response';
      const statusCell = cell(row, statusLabel, `status-cell status-${result.errorType && result.errorType !== 'redirect' ? 'unverified' : result.status ? Math.floor(result.status / 100) : 'error'}`);
      statusCell.setAttribute('aria-label', `Status: ${statusCell.textContent}`);
      cell(row, result.ms ? `${result.ms} ms` : result.error ? '—' : '0 ms', 'num-cell'); cell(row, String(Math.max(0, result.hops.length - 1)), 'num-cell');
      const signal = row.insertCell();
      if (!result.issues.length) { const tag = document.createElement('span'); tag.className = 'signal good'; tag.textContent = 'Looks good'; signal.append(tag); }
      else for (const issue of result.issues) { const tag = document.createElement('span'); tag.className = `signal${category(result) === 'unverified' ? ' unverified' : ''}`; tag.textContent = issue; signal.append(tag); }
      resultsBody.append(row);
    }
  }
  textarea.addEventListener('input', updateCount);
  document.querySelector('#sample-button')!.addEventListener('click', () => { expected.clear(); textarea.value = 'https://example.com\nhttp://example.com\nhttps://www.wikipedia.org/'; updateCount(); textarea.focus(); });
  function csvFields(line:string) { const fields:string[]=[]; let value=''; let quoted=false; for(let i=0;i<line.length;i++){const char=line[i];if(char==='"'){if(quoted&&line[i+1]==='"'){value+='"';i++;}else quoted=!quoted;}else if(char===','&&!quoted){fields.push(value.trim());value='';}else value+=char;}fields.push(value.trim());return fields; }
  document.querySelector<HTMLInputElement>('#file-input')!.addEventListener('change', async event => {
    const file = (event.target as HTMLInputElement).files?.[0]; if (!file) return;
    if (file.size > 100_000) return error('Choose a file smaller than 100 KB.');
    expected.clear(); const text = (await file.text()).replace(/^\ufeff/,''); const found:string[]=[];
    for(const line of text.split(/\r?\n/)){const [source,target]=file.name.toLowerCase().endsWith('.csv')?csvFields(line):[line.trim()];if(!source||! /^(https?:\/\/|[\w.-]+\.[a-z]{2,})/i.test(source))continue;const normalized=normalize(source);found.push(normalized);if(target){try{const url=new URL(normalize(target));if(['http:','https:'].includes(url.protocol))expected.set(normalized,url.href);}catch{/* Skip invalid expected destination. */}}}
    textarea.value = [...new Set(found)].join('\n'); updateCount(); error(''); (event.target as HTMLInputElement).value='';
  });
  cancel.addEventListener('click', () => controller?.abort());
  button.addEventListener('click', async () => {
    const urls = lines().map(normalize);
    if (!urls.length) return error('Add at least one URL to check.');
    if (urls.length > 50) return error('This check supports up to 50 unique URLs.');
    const invalid = urls.find(value => { try { const u = new URL(value); return !['http:', 'https:'].includes(u.protocol) || !u.hostname.includes('.'); } catch { return true; } });
    if (invalid) return error(`Please check this URL: ${invalid}`);
    error(''); results = []; controller = new AbortController(); button.disabled = true; cancel.hidden = false; resultsSection.hidden = false; progress.textContent = `Processing 0 of ${urls.length}…`; render();
    try {
      for (let i = 0; i < urls.length; i += 5) {
        const response = await fetch('/api/check/', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ urls: urls.slice(i, i + 5) }), signal: controller.signal });
        const contentType = response.headers.get('content-type') || '';
        if (!contentType.toLowerCase().includes('application/json')) {
          throw new Error(`Checker API unavailable (HTTP ${response.status}). The live site returned a web page instead of JSON. Check that the Worker API is deployed at /api/check/.`);
        }
        let data: { error?: string; results?: Result[] };
        try { data = await response.json(); }
        catch { throw new Error('Checker API returned invalid JSON. Check the Cloudflare Pages deployment logs.'); }
        if (!response.ok) throw new Error(data.error || `The checker API returned HTTP ${response.status}.`);
        if (!Array.isArray(data.results)) throw new Error('Checker API response is missing results. Check the Cloudflare Pages deployment.');
        for(const item of data.results){const target=expected.get(item.input);if(target){item.expectedUrl=target;if(item.finalUrl&&!item.error&&item.finalUrl!==target)item.issues.push('Unexpected destination');}results.push(item);} progress.textContent = `Processed ${results.length} of ${urls.length}`; render();
      }
      progress.textContent = `Done — ${results.length} URL${results.length === 1 ? '' : 's'} processed.`;
    } catch (cause) {
      if (controller.signal.aborted) progress.textContent = `Stopped after ${results.length} URLs.`;
      else error(cause instanceof Error ? cause.message : 'The check could not be completed.');
    } finally { controller = null; button.disabled = false; cancel.hidden = true; }
  });
  document.querySelectorAll<HTMLButtonElement>('.filter').forEach(filter => filter.addEventListener('click', () => { activeFilter = filter.dataset.filter || 'all'; document.querySelectorAll('.filter').forEach(node => node.classList.toggle('active', node === filter)); render(); }));
  document.querySelector('#export-button')!.addEventListener('click', () => {
    const columns = ['Input URL','Expected destination','Final URL','Status','Status text','Time (ms)','Redirect hops','Redirect path','Title','Canonical','Robots','Content type','Issues','Error'];
    const rows = results.map(r => [r.input,r.expectedUrl,r.finalUrl,r.status,r.statusText,r.ms,Math.max(0,r.hops.length-1),r.hops.map(h=>`${h.status} ${h.url}`).join(' → '),r.title,r.canonical,r.robots,r.contentType,r.issues.join('; '),r.error]);
    const csv = [columns,...rows].map(row => row.map(value => `"${String(value ?? '').replaceAll('"','""')}"`).join(',')).join('\r\n');
    const url = URL.createObjectURL(new Blob(['\ufeff',csv], { type:'text/csv;charset=utf-8' }));
    const link = document.createElement('a'); link.href = url; link.download = `statusgrid-${new Date().toISOString().slice(0,10)}.csv`; link.click(); setTimeout(()=>URL.revokeObjectURL(url),1000);
  });
</script>

<style>
